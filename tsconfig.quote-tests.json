{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": ".tmp-quote-tests",
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "lib/quotes/**/*.ts",
    "tests/**/*.ts"
  ]
}
