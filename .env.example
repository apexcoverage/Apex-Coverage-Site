OPENAI_API_KEY=
OPENAI_QUOTE_MODEL=gpt-5

# Use a long random value in production.
APEX_INTERNAL_AUTH_SECRET=

# Employees are configured server-side so agents cannot edit quote instructions.
# For production, prefer passwordHash values formatted as sha256:<hash>.
APEX_EMPLOYEES_JSON=[{"email":"agent@driveapexcoverage.com","name":"Agent Name","role":"EMPLOYEE","password":"change-me"}]

# Local quote history storage. The app uses SQLite through Node when available.
APEX_QUOTE_DB_PATH=.data/apex-quotes.sqlite

# Google Ads conversion tracking for the ad landing page form.
# Easiest option: paste the full Google Ads "send_to" value here.
# Example format: NEXT_PUBLIC_GOOGLE_ADS_AD_LEAD_SEND_TO=AW-123456789/abcDEFghiJKLmnop
NEXT_PUBLIC_GOOGLE_ADS_AD_LEAD_SEND_TO=

# Optional split setup if you prefer separating the ID and conversion label.
# Example format: NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18491289640
NEXT_PUBLIC_GOOGLE_ADS_AD_LEAD_CONVERSION_LABEL=
